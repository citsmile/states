{
  "name": "states",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Monorepo for States app",
  "main": "index.js",
  "scripts": {
    "dev:api": "tsx apps/api/server.ts",
    "dev:web": "vite --config vite.config.ts apps/web",
    "test:unit": "vitest run apps/tests",
    "test:e2e": "dotenv -e .env.test -- playwright test playwright",
    "db:reset": "prisma migrate reset",
    "db:migrate": "prisma migrate dev",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:seed": "prisma db seed",
    "db:test:reset": "dotenv -e .env.test -- prisma migrate reset -f",
    "db:test:migrate": "dotenv -e .env.test -- prisma migrate dev",
    "build:web": "vite build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "test:web": "npm run build:web && dotenv -e .env.test -- tsx apps/api/server.ts",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@vitejs/plugin-react": "^4.3.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsdom": "^26.0.0",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.1",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "sass": "^1.101.3",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
