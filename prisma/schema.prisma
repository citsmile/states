// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model State {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  population Int
  counties   County[]
}

model County {
  id         Int    @id @default(autoincrement())
  stateId    Int
  name       String
  population Int
  state      State  @relation(fields: [stateId], references: [id])
}
